# The repo root ignores *.pkl and various data globs. The ML pipeline needs a
# few of those artifacts tracked so the project is reproducible from a clone,
# so re-include them explicitly here.
!data/fatigue_model.pkl
!data/*.parquet
!data/game_ids/*.parquet
!data/box_scores/*.parquet

# Scraping beyond the committed development cache is regenerable — a full
# 3-season scrape is ~3,700 games and does not belong in git. If you run
# `python predict.py --scrape --seasons 2022-23 2023-24 2024-25`, uncomment:
# data/box_scores/
# data/player_game_quarters*.parquet

__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.claude/
